{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.backlink-agent/schemas/task.schema.json",
  "title": "Backlink Browser Agent Task",
  "type": "object",
  "required": ["version", "type", "provider", "input"],
  "properties": {
    "version": { "const": "1.0" },
    "taskId": { "type": "string" },
    "type": { "type": "string" },
    "provider": { "type": "string" },
    "input": {
      "type": "object",
      "required": ["domain"],
      "properties": {
        "domain": { "type": "string", "minLength": 1 },
        "page": { "type": "integer", "minimum": 1 },
        "scope": { "enum": ["domain", "subdomain", "url"] },
        "entryUrl": { "type": "string", "format": "uri" }
      }
    },
    "limits": {
      "type": "object",
      "properties": {
        "maxPages": { "type": "integer", "minimum": 1 },
        "maxRecords": { "type": "integer", "minimum": 1 }
      }
    },
    "execution": {
      "type": "object",
      "properties": {
        "mode": { "enum": ["quiet", "visible"] },
        "manualSubmit": { "type": "boolean" }
      }
    }
  }
}
